APP_NAME=NodePanel
ENVIRONMENT=production
SECRET_KEY=change-this-secret-key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-this-viewer-password

BIND_HOST=0.0.0.0
BIND_PORT=420
NODEPANEL_HOST_PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DATA_ROOT=/app/data
STAGING_ROOT=/app/staging
INBOX_ROOT=/app/inbox
LEDGER_ROOT=/app/ledger
DATABASE_PATH=/app/data/nodepanel.db

FACTORY_HOST=127.0.0.1
FACTORY_PORT=22
FACTORY_USER=nodepanel
FACTORY_DIR=~/nodefactory
FACTORY_SSH_KEY_PATH=/run/secrets/factory_ssh_key

VM_SSH_KEY_PATH=/run/secrets/vm_ssh_key
SSH_KNOWN_HOSTS_PATH=/app/data/known_hosts
SSH_USE_AGENT=false
SSH_CONNECT_TIMEOUT_SECONDS=10

MAX_TRANSFER_BYTES=1073741824
MAX_TRANSFER_FILES=5000
MAX_INDIVIDUAL_FILE_BYTES=134217728
TRANSFER_TIMEOUT_SECONDS=600

GITHUB_KNOWN_HOSTS_ENTRY=github.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
